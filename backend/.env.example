# JARVIS AI Backend — copy to .env and fill in values.
# NEVER commit the real .env file.

PORT=8080
NODE_ENV=production
HOST=0.0.0.0

# Required: long random string used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
REFRESH_EXPIRES_DAYS=30

# Gemini — keep this ONLY on the server. Never put it in the Android app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# First admin account (created on first boot if no admin exists)
ADMIN_EMAIL=admin@jarvis.local
ADMIN_PASSWORD=

# Optional SMTP for forgot-password codes. If unset, codes are not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JARVIS AI <noreply@jarvis.local>

# Optional CORS extra origins (comma-separated)
CORS_ORIGINS=

# Database file path
DB_PATH=./data/jarvis.sqlite

# Public URL of this backend (used in emails)
PUBLIC_URL=http://localhost:8080
